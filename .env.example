# Copy this file to .env and fill in your key. Never commit .env.
# Every value except OPENROUTER_API_KEY is optional; the defaults are shown.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM (via OpenRouter: https://openrouter.ai/models) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fast, cheap model: incident classification and Slack drafts
CLASSIFIER_MODEL=openai/gpt-4o-mini
# Stronger model: remediation plans, cookbook and JIRA tickets
REASONING_MODEL=openai/gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- Storage (relative to the project folder) ---
DATABASE_PATH=data/incident_suite.db
CHROMA_PERSIST_DIR=data/chroma
UPLOAD_DIR=data/uploads
RUNBOOK_DIR=data/runbooks
SAMPLE_LOG_DIR=data/sample_logs
APP_LOG_FILE=data/logs/app.jsonl

# --- Runbook retrieval (local, free embeddings) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
# Cosine distance 0-2; runbook chunks farther than this are ignored (relevant matches here score < 0.6)
RETRIEVAL_MAX_DISTANCE=0.6

# --- Limits ---
MAX_UPLOAD_MB=20
MAX_PARSED_EVENTS=20000
MAX_EVENTS_FOR_CLASSIFICATION=200
MAX_JIRA_TICKETS=5

# --- Slack: simulation (default, nothing is sent) or live ---
SLACK_MODE=simulation
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#all-outskill-hackathon-incident-management

# --- JIRA: simulation (default, nothing is created) or live ---
JIRA_MODE=simulation
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task

# --- API / UI ---
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:8600","http://127.0.0.1:8600"]
# Set a long random value to require an X-API-Key header on /api (the UI sends it automatically).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
RATE_LIMIT_UPLOADS_PER_MINUTE=10
# Where the Streamlit UI finds the API
API_BASE_URL=http://localhost:8000
